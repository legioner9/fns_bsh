**:002.01.toc2md.us.sh

<code>
	fns__toc2md() {

		# $fns__dr_dta/chpt.md
		# $fns__dr_dta/body.md
		#! $fns__dr_dta/body_toc.md result
		local pnt=
		local anc=
		local str=
		local rnd_1=

		IFS=$'\n'
		for str in $(<$fns__dr_dta/chpt.md); do
			echo "$str"
			#  - <a href=#35a6b9d026864bd79ab8bfd21541e3fa> Local repo opuses</a>
			#<a id="16d01bbb8a3048f18d8665782e885627"></a>
			rnd_1=$(tr -dc 0-9A-Za-z </dev/urandom | head -c 32)
			pnt="- <a href=#$rnd_1>$str</a>"
			anc="<a id=\"$rnd_1\"></a>"
			#sed '/^b/i ascsdc' init/init.fl > res.fl

			eval "sed -i '/$str/i $anc' $fns__dr_dta/body_toc.md"
			eval "sed -i '/ETOC/i $pnt' $fns__dr_dta/body_toc.md"



		done
		IFS=

		lfoe_path_to_var $fns__dr_dta/body_toc.md
		read -p fns__toc2md
	}
</code>
