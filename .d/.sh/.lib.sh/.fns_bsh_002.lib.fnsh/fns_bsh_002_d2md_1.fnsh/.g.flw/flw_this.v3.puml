# $1 :: $arg_1
: >"$2"
# $2 deep
local deep="$2"

for item in $(l_02_d2e "$1"); do

	if [[ -d "$1/$item" ]]; then

		fns__dd "$1/$item" $deep

		fns__dr "$1/$item" $(($deep + 1))

