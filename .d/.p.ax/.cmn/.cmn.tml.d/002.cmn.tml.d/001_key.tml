	[[ "$1" == "_tst" ]] && {
		echo -e "
        this [. .tst] for <${FUNCNAME[0]}> ::
        doing_tst :: 
			\$1 - dr_res
			\$2 - res.fl
			\$3 - 
            exa use ::
            far use ::
        "
		return 0
	}

		[[ "$1" == "_vis" ]] && {
		echo -e "
        this [cat .vis] for <${FUNCNAME[0]}> ::
        doing_vis :: 
			\$1 - dr_res
			\$2 - res.fl
			\$3 - 
            exa use ::
            far use ::
        "
		return 0
	}

	#-- {{002_key}}
	