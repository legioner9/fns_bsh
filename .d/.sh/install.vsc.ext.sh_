#!/bin/bash

# bash formatter
code --install-extension mkhl.shfmt
# bash theme
code --install-extension gerane.Theme-bashling
# icon theme
code --install-extension PKief.material-icon-theme
# pdf vieuer
code --install-extension tomoki1207.pdf
# svg viuer
code --install-extension sile.pixcil
# assembler gas
code --install-extension basdp.language-gas-x86
# clang format
code --install-extension xaver.clang-format
# clang main
code --install-extension ms-vscode.cpptools
# clang sippets
code --install-extension hars.CppSnippets
# autocomplete path
code --install-extension ionutvmi.path-autocomplete
# makefile tools
code --install-extension ms-vscode.makefile-tools
# todo tree
code --install-extension Gruntfuggly.todo-tree
# todo color comments
#? todo color comments
#! todo color comments
#* todo color comments
#.. todo color comments
code --install-extension aaron-bond.better-comments
# cmp dr
code --install-extension moshfeu.compare-folders
# symlinks
code --install-extension anbuselvan.vscode-symlink
# color md files

# shellchec k
code --install-extension timonwong.shellcheck
