	fns__gig_d_mkdr() {

		local pr_dr=$(l_01_prs_f -d $arg_2)
		local nm_dr=_$(l_01_prs_f -ne $arg_2).d

		if ! (
			rm -f $pr_dr/$nm_dr
			mkdir $pr_dr/$nm_dr
		) >/dev/null; then
			return 1
		fi
	}
